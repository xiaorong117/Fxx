{
  "config_version": 2,
  "solver": {
    "solver": "PBICGSTAB",
    "preconditioner": {
      "solver": "AMG",
      "algorithm": "AGGREGATION",
      "smoother": {"solver":"BLOCK_JACOBI","relaxation_factor":0.9,"scope":"amg_smoother"},
      "presweeps": 1,
      "postsweeps": 2,
      "max_iters": 1,
      "cycle": "W",
      "selector": "SIZE_2",
      "max_levels": 50,
      "scope": "amg"
    },
    "max_iters": 2000,
    "convergence": "RELATIVE_INI",
    "tolerance": 1e-8,
    "norm": "L2",
    "monitor_residual": 1,
    "obtain_timings": 1,
    "print_solve_stats": 0,
    "scope": "main"
  }
}
