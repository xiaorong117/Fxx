{
  "config_version": 2,
  "solver": {
    "solver": "FGMRES",
    "preconditioner": {
      "solver": "AMG",
      "algorithm": "AGGREGATION",
      "selector": "SIZE_2",
      "smoother": "MULTICOLOR_DILU",
      "presweeps": 2,
      "postsweeps": 4,
      "max_iters": 2,
      "cycle": "W",
      "error_scaling": 2,
      "coarse_solver": "NOSOLVER",
      "min_coarse_rows": 32,
      "max_levels": 50,
      "matrix_coloring_scheme": "PARALLEL_GREEDY",
      "max_uncolored_percentage": 0.05,
      "scope": "amg"
    },
    "max_iters": 500,
    "gmres_n_restart": 200,
    "convergence": "RELATIVE_INI",
    "tolerance": 1e-10,
    "norm": "L2",
    "monitor_residual": 1,
    "obtain_timings": 1,
    "print_solve_stats": 0,
    "scope": "main"
  }
